{
  "expo": {
    "name": "Obsidian Calculator",
    "slug": "obsidian-calculator",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06080D",
    "scheme": "obsidian-calc",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#06080D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.obsidian.calculator",
      "backgroundColor": "#06080D"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06080D"
      },
      "package": "com.obsidian.calculator",
      "backgroundColor": "#06080D",
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-haptics"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
